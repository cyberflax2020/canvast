#!/usr/bin/env node
const fs = require("node:fs");
const path = require("node:path");

function usage() {
  console.log("fd 10.0.0-canvast-shim");
}

function normalize(value) {
  return value.replace(/\\/g, "/");
}

function globToRegExp(glob) {
  let out = "^";
  for (let i = 0; i < glob.length; i += 1) {
    const ch = glob[i];
    const next = glob[i + 1];
    if (ch === "*" && next === "*") {
      out += ".*";
      i += 1;
    } else if (ch === "*") {
      out += "[^/]*";
    } else if (ch === "?") {
      out += "[^/]";
    } else if ("\\^$+?.()|{}[]".includes(ch)) {
      out += `\\${ch}`;
    } else {
      out += ch;
    }
  }
  out += "$";
  return new RegExp(out);
}

function parseArgs(argv) {
  const opts = {
    baseDirectory: null,
    excludes: [],
    fullPath: false,
    glob: false,
    maxResults: Number.POSITIVE_INFINITY,
    types: new Set(),
    positional: [],
  };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "--") {
      opts.positional.push(...argv.slice(i + 1));
      break;
    }
    if (arg === "--version" || arg === "-V") {
      opts.version = true;
    } else if (arg === "--base-directory") {
      opts.baseDirectory = argv[++i] || ".";
    } else if (arg === "--max-results") {
      opts.maxResults = Math.max(0, Number.parseInt(argv[++i] || "0", 10) || 0);
    } else if (arg === "--type" || arg === "-t") {
      opts.types.add(argv[++i] || "");
    } else if (arg === "--exclude" || arg === "-E") {
      opts.excludes.push(argv[++i] || "");
    } else if (arg === "--full-path" || arg === "-p") {
      opts.fullPath = true;
    } else if (arg === "--glob" || arg === "-g") {
      opts.glob = true;
    } else if (arg === "--color=never" || arg === "--hidden" || arg === "--follow" || arg === "--no-require-git") {
      // Supported no-op flags for Canvast/pi startup, autocomplete, and find.
    } else if (arg.startsWith("-")) {
      // Ignore unknown fd flags rather than failing startup completion.
    } else {
      opts.positional.push(arg);
    }
  }
  return opts;
}

function shouldExclude(rel, excludes) {
  const normalized = normalize(rel);
  if (normalized === ".git" || normalized.startsWith(".git/") || normalized.includes("/.git/")) return true;
  if (normalized === ".runtime" || normalized.startsWith(".runtime/") || normalized.includes("/.runtime/")) return true;
  if (normalized === "node_modules" || normalized.startsWith("node_modules/") || normalized.includes("/node_modules/")) return true;
  if (normalized === ".canvast-worktrees" || normalized.startsWith(".canvast-worktrees/") || normalized.includes("/.canvast-worktrees/")) return true;
  return excludes.some((item) => {
    if (!item) return false;
    const clean = item.replace(/\/\*\*?$/, "");
    return normalized === clean || normalized.startsWith(`${clean}/`);
  });
}

function walk(root, opts) {
  const results = [];
  const seen = new Set();
  const follow = true;
  function visit(abs) {
    let stat;
    try {
      stat = follow ? fs.statSync(abs) : fs.lstatSync(abs);
    } catch {
      return;
    }
    let real = abs;
    try {
      real = fs.realpathSync.native(abs);
    } catch {
      // Keep the unresolved path.
    }
    if (stat.isDirectory()) {
      if (seen.has(real)) return;
      seen.add(real);
    }
    const rel = normalize(path.relative(root, abs)) || ".";
    if (rel !== "." && shouldExclude(rel, opts.excludes)) return;
    if (rel !== ".") {
      const isDir = stat.isDirectory();
      const includeFiles = opts.types.size === 0 || opts.types.has("f") || opts.types.has("file");
      const includeDirs = opts.types.size === 0 || opts.types.has("d") || opts.types.has("directory");
      if ((isDir && includeDirs) || (!isDir && includeFiles)) {
        results.push({ abs, rel, isDir });
      }
    }
    if (!stat.isDirectory()) return;
    let entries = [];
    try {
      entries = fs.readdirSync(abs, { withFileTypes: true });
    } catch {
      return;
    }
    entries.sort((a, b) => a.name.localeCompare(b.name));
    for (const entry of entries) visit(path.join(abs, entry.name));
  }
  visit(root);
  return results;
}

function matcher(opts, pattern) {
  if (!pattern) return () => true;
  if (opts.glob) {
    const re = globToRegExp(normalize(pattern));
    return (item) => {
      const target = opts.fullPath || pattern.includes("/") ? normalize(item.rel) : path.basename(item.rel);
      return re.test(target);
    };
  }
  let re;
  try {
    re = new RegExp(pattern);
  } catch {
    re = new RegExp(pattern.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
  }
  return (item) => re.test(opts.fullPath ? normalize(item.abs) : path.basename(item.rel));
}

const opts = parseArgs(process.argv.slice(2));
if (opts.version) {
  usage();
  process.exit(0);
}

const pattern = opts.positional[0] || "";
const root = path.resolve(opts.baseDirectory || opts.positional[1] || ".");
const match = matcher(opts, pattern);
const rows = walk(root, opts).filter(match).slice(0, opts.maxResults);
for (const row of rows) {
  let output = opts.baseDirectory ? row.rel : row.abs;
  output = normalize(output);
  if (row.isDir && !output.endsWith("/")) output += "/";
  console.log(output);
}
