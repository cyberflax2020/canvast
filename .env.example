# Canvast environment template / 环境变量模板
# Copy to .env and fill in your key. .env is gitignored; never commit keys.
# 复制为 .env 并填入密钥。.env 已被 gitignore；绝不提交密钥。

# DeepSeek API key (https://platform.deepseek.com) — used by the default provider
DEEPSEEK_API_KEY=

# Optional overrides / 可选覆盖
# CANVAST_PROVIDER=deepseek
# CANVAST_MODEL=deepseek-v4-pro
# CANVAST_THINKING=high
# CANVAST_SUBAGENT_MODEL=deepseek-v4-pro
# CANVAST_TASK_DEADLINE_MS=
